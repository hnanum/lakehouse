WITH country_revenue AS (
  SELECT
    Country,
    SUM(TotalRevenue) AS total_revenue
  FROM
    gold_online_retail
  WHERE
    (
      :date_range.min IS NULL
      OR TransactionDate >= :date_range.min
    )
    AND (
      :date_range.max IS NULL
      OR TransactionDate <= :date_range.max
    )
    AND (
      :country IS NULL
      OR array_contains(:country, Country)
    )
  GROUP BY
    Country
),
ranked AS (
  SELECT
    Country,
    total_revenue,
    ROW_NUMBER() OVER (ORDER BY total_revenue DESC) AS revenue_rank
  FROM
    country_revenue
)
SELECT
  CASE
    WHEN revenue_rank <= 5 THEN Country
    ELSE 'Other'
  END AS country_group,
  SUM(total_revenue) AS total_revenue
FROM
  ranked
GROUP BY
  CASE
    WHEN revenue_rank <= 5 THEN Country
    ELSE 'Other'
  END
ORDER BY
  total_revenue DESC
