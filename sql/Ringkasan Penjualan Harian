SELECT
  TransactionDate,
  Country,
  TotalTransactions,
  TotalItemsSold,
  TotalRevenue
FROM
  gold_online_retail
WHERE
  (
    :date_range.min IS NULL
    OR TransactionDate >= :date_range.min
  )
  AND (
    :date_range.max IS NULL
    OR TransactionDate <= :date_range.max
  )
  AND (
    :country IS NULL
    OR array_contains(:country, Country)
  )
ORDER BY
  TransactionDate DESC,
  TotalRevenue DESC
LIMIT 50
