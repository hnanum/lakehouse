SELECT
  SUM(TotalRevenue) AS total_revenue,
  SUM(TotalItemsSold) AS total_items_sold,
  SUM(TotalTransactions) AS total_transactions,
  SUM(TotalRevenue) / NULLIF(SUM(TotalTransactions), 0) AS avg_revenue_per_transaction
FROM
  gold_online_retail
WHERE
  (
    :date_range.min IS NULL
    OR TransactionDate >= :date_range.min
  )
  AND (
    :date_range.max IS NULL
    OR TransactionDate <= :date_range.max
  )
  AND (
    :country IS NULL
    OR array_contains(:country, Country)
  )
