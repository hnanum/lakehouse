SELECT
    DATE_TRUNC('month', TransactionDate) AS sales_month,
    DATE_FORMAT(TransactionDate, 'yyyy-MM') AS bulan_label,
    SUM(TotalRevenue) AS total_revenue
FROM workspace.lakeschema.gold_online_retail
WHERE
    (
        :date_range.min IS NULL
        OR TransactionDate >= :date_range.min
    )
    AND (
        :date_range.max IS NULL
        OR TransactionDate <= :date_range.max
    )
    AND (
        :country IS NULL
        OR array_contains(:country, Country)
    )
GROUP BY
    DATE_TRUNC('month', TransactionDate),
    DATE_FORMAT(TransactionDate, 'yyyy-MM')
ORDER BY
    sales_month ASC;
